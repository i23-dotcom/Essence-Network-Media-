:root{--bg:#050813;--panel:#0a1020;--panel2:#0d1427;--line:#202b45;--text:#eef3ff;--muted:#8e9ab6;--purple:#8b5cf6;--cyan:#22d3ee;--red:#ef4444;--green:#35d07f;--yellow:#f7c948}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 70% 0,#101638 0,#050813 38%,#04060c 100%);color:var(--text);font:14px Inter,system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.login{min-height:100vh;display:grid;place-items:center;padding:24px}.login-card{width:min(440px,100%);padding:34px;border:1px solid var(--line);border-radius:22px;background:rgba(10,16,32,.92);box-shadow:0 24px 80px #0008}.brand-mark{font-size:36px;font-weight:900;letter-spacing:-5px;color:#a56cff}.brand-mark span{font-size:14px;color:var(--cyan);letter-spacing:-3px;margin-left:5px}.brand-mark.small{font-size:25px}.eyebrow{font-size:10px;letter-spacing:2.4px;color:var(--cyan);font-weight:800}.login h1{font-size:32px;margin:8px 0}.login p,.muted{color:var(--muted);line-height:1.5}.login-fields{display:grid;gap:10px;margin:22px 0}.login input,.form input,.form select,.form textarea{width:100%;background:#070c18;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:12px;outline:none}.login input:focus,.form input:focus,.form select:focus,.form textarea:focus{border-color:var(--purple)}.primary,.take,.ghost,.danger,.icon-btn{border:1px solid var(--line);border-radius:10px;padding:10px 14px;color:var(--text);background:#10182c}.primary{background:linear-gradient(135deg,#8b5cf6,#5b4bf4);border-color:#9b7aff}.take{background:linear-gradient(135deg,#ef4444,#c72d3e);border-color:#ff6a72;font-weight:900;box-shadow:0 0 24px #ef444433}.take span{font-size:10px;opacity:.7}.ghost{background:#0b1221}.danger{color:#ff9a9f}.wide{width:100%}.login .ghost{margin-top:10px}.msg{min-height:20px;margin-top:10px;color:#ff9a9f}.topbar{height:64px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:22px;padding:0 18px;background:#060a13e8;backdrop-filter:blur(16px)}.brand{display:flex;align-items:center;gap:9px;min-width:185px}.brand b{display:block;letter-spacing:1.5px}.brand small{display:block;color:var(--cyan);letter-spacing:2px;font-size:8px}.crumb{color:#aab4cb;font-size:12px;font-weight:700}.pill{margin-left:8px;padding:4px 7px;border-radius:999px;background:#12213a;color:#7eeaff;font-size:9px}.top-actions{margin-left:auto;display:flex;gap:14px;align-items:center;color:#aeb8ce}.health{font-size:11px}.health.ok{color:var(--green)}.health.warn{color:var(--yellow)}.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 64px)}.sidebar{border-right:1px solid var(--line);padding:14px 10px;display:flex;flex-direction:column;gap:5px;background:#070b15}.sidebar button{border:0;background:transparent;color:#a9b3c9;text-align:left;padding:12px;border-radius:10px}.sidebar button:hover,.sidebar button.active{background:#111a30;color:#fff}.sidebar button.active{box-shadow:inset 2px 0 var(--cyan)}.sidebar button span{margin-left:8px}.side-bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:14px}.signal{display:flex;gap:9px;padding:10px;color:#cbd4e7}.signal i{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);margin-top:4px}.signal b,.signal small{display:block}.signal small{color:var(--muted);font-size:10px;margin-top:2px}.side-link{width:100%}.main{padding:22px;min-width:0}.page-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.page-head h2{margin:3px 0 0;font-size:27px}.head-actions{display:flex;gap:9px}.panel{background:linear-gradient(180deg,#0b1222,#080e1b);border:1px solid var(--line);border-radius:16px;padding:15px;box-shadow:0 10px 35px #0002}.monitor-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.monitor{position:relative;aspect-ratio:16/9;overflow:hidden;background:#02050a;border:1px solid #2a3653;border-radius:12px}.monitor .label{position:absolute;z-index:3;left:10px;top:9px;padding:5px 8px;border-radius:6px;background:#060b16cc;font-size:10px;font-weight:800;letter-spacing:1px}.monitor.program{border-color:#ef4444aa}.monitor.preview{border-color:#8b5cf688}.monitor video,.monitor .scene-canvas{width:100%;height:100%;object-fit:cover;display:block}.monitor .empty{position:absolute;inset:0;display:grid;place-items:center;color:#52607a;font-size:13px}.monitor .live-dot{position:absolute;right:10px;top:9px;color:#fff;background:#df3041;border-radius:6px;padding:5px 7px;font-size:9px;font-weight:900}.monitor-footer{display:flex;justify-content:space-between;margin-top:8px;color:var(--muted);font-size:11px}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}.metric{padding:12px;border:1px solid var(--line);border-radius:12px;background:#080e1a}.metric b{font-size:20px}.metric small{display:block;color:var(--muted);margin-top:3px}.source-grid,.scene-grid,.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.source-card,.scene-card,.cue-card{padding:14px;border:1px solid var(--line);border-radius:13px;background:#090f1d}.source-card.active,.scene-card.active{border-color:var(--cyan);box-shadow:0 0 0 1px #22d3ee22}.source-card h4,.scene-card h4{margin:0 0 5px}.source-card p,.scene-card p{margin:0;color:var(--muted);font-size:12px}.source-actions{display:flex;gap:8px;margin-top:12px}.row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.row:last-child{border-bottom:0}.row-main{flex:1}.status{padding:4px 7px;border-radius:999px;background:#121d34;color:#a9b9d5;font-size:10px}.status.live{color:#ff9a9f;background:#35131a}.form{display:grid;gap:10px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid .full{grid-column:1/-1}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.range{width:100%}.meter{height:8px;background:#11192b;border-radius:99px;overflow:hidden}.meter i{display:block;height:100%;width:55%;background:linear-gradient(90deg,#22d3ee,#8b5cf6)}.cue-list{display:grid;gap:8px}.cue-card{display:flex;align-items:center;gap:12px}.cue-card .num{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:#111a30;color:#a9b7d0;font-weight:800}.cue-card .grow{flex:1}.toast{position:fixed;right:22px;bottom:22px;z-index:50;padding:12px 15px;border-radius:10px;background:#131d33;border:1px solid #3a4a70;box-shadow:0 14px 40px #0008}.split{display:grid;grid-template-columns:1.3fr .7fr;gap:14px}.small-note{font-size:11px;color:var(--muted)}@media(max-width:1000px){.layout{grid-template-columns:70px 1fr}.sidebar button span,.brand>div:last-child,.crumb{display:none}.source-grid,.scene-grid,.card-grid{grid-template-columns:1fr 1fr}.quick-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.monitor-grid,.split,.source-grid,.scene-grid,.card-grid{grid-template-columns:1fr}.topbar{padding:0 10px}.top-actions #userBadge{display:none}.main{padding:12px}.page-head{align-items:flex-start}.head-actions{margin-top:5px}.sidebar{padding:8px 5px}.form-grid{grid-template-columns:1fr}}

.monitor canvas{width:100%;height:100%;display:block}.preview-graphic{position:absolute;left:5%;right:5%;bottom:7%;padding:12px 16px;background:linear-gradient(90deg,#111a35ee,#081321dd);border-left:4px solid #8b5cf6;z-index:2}.preview-graphic b,.preview-graphic small{display:block}.preview-graphic small{color:#a9b6d1;margin-top:3px}.monitor .empty{z-index:1;pointer-events:none}
